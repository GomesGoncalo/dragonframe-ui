# Copy to relay.env (and `chmod 600 relay.env`).
# A long-lived access token from Home Assistant: your profile (bottom left), Security,
# "Long-lived access tokens", Create token. It stays on this machine.
HA_TOKEN=
# The two lines the frame's page gives you: Frame tab, House, "Connect the house".
FRAME_URL=http://192.168.4.23:8080
FRAME_KEY=
